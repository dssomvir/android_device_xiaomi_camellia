cc_library_headers {
    name: "camellia_xiaomifingerprint_headers",
    export_include_dirs: ["include"],
    vendor: true,
    header_libs: ["libhardware_headers"],
    export_header_lib_headers: ["libhardware_headers"],
}

cc_library_static {
    name: "camellia_libudfpshandlerfactory",
    srcs: ["UdfpsHandler.cpp"],
    vendor: true,
    header_libs: ["camellia_xiaomifingerprint_headers"],
}

cc_binary {
    name: "android.hardware.biometrics.fingerprint@2.3-service.camellia",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.biometrics.fingerprint@2.3-service.camellia.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint@2.3-service.camellia.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "BiometricsFingerprint.cpp",
        "service.cpp",
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "libdl",
        "liblog",
        "libhidlbase",
        "libhardware",
        "libutils",
        "android.hardware.biometrics.fingerprint@2.1",
        "android.hardware.biometrics.fingerprint@2.2",
        "android.hardware.biometrics.fingerprint@2.3",
    ],

    static_libs: [
        "camellia_libudfpshandlerfactory",
    ],

    header_libs: ["camellia_xiaomifingerprint_headers"],
}
